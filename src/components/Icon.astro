---
// The three arrows the Framer project uses (Phosphor-style strokes).
interface Props { name: "up-right" | "left" | "right"; small?: boolean }
const { name, small } = Astro.props
const d = { "up-right": "M7 17 17 7M8 7h9v9", left: "M19 12H5m6-6-6 6 6 6", right: "M5 12h14m-6-6 6 6-6 6" }[name]
---
<svg class={small ? "icon-sm" : "icon"} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
